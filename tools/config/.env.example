# Telegram bot (required)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Redis (required for queue)
REDIS_URL=redis://localhost:6379/0

# Repo root (default: parent of tools/)
# AI_ROBOTICS_REPO_ROOT=/path/to/ai_in_robotics

# Host repo path for the autograder container (must match the bind mount in docker-compose.yml).
# When running containerised on V100, set this to the actual repo path on the host, e.g.:
HOST_REPO_ROOT=/srv/ai_in_robotics

# Allowlist: comma-separated Telegram user IDs (optional; empty = use SQLite allowed_users)
# ALLOWED_TELEGRAM_IDS=123456789,987654321

# Run limits (defaults; overridden per week in */homework/autograder.yaml)
# AUTOGRADER_TIMEOUT_SEC=120
# Host subprocess max = limits.timeout_sec + AUTOGRADER_DOCKER_OVERHEAD_SEC (default 600).
# Test wall time is capped inside the container at limits.timeout_sec; overhead is only for image build/pull.
# AUTOGRADER_DOCKER_OVERHEAD_SEC=600
AUTOGRADER_MEMORY_MB=512
AUTOGRADER_CPUS=1
AUTOGRADER_MAX_CONCURRENT=2

# Rate limit: seconds between submissions per user per week (0 = disabled)
RATE_LIMIT_SEC=300

# SQLite paths (default: tools/data/)
# GRADES_DB_PATH=tools/data/grades.db
# ALLOWLIST_DB_PATH=tools/data/allowlist.db

# Full pytest/Docker logs per submission (default: tools/data/grading_logs/{week_id}/)
# GRADING_LOGS_PATH=tools/data/grading_logs

# Oracle (optional; if unset, bot/autograder skip oracle calls)
ORACLE_BASE_URL=http://localhost:9000
ORACLE_ENABLED=false
ORACLE_LLM_BASE_URL=http://localhost:8000/v1
ORACLE_LLM_MODEL=glm-5-fp8
ORACLE_TIMEOUT_SEC=60

# Oracle Docker (SGLang LLM + Oracle in one container)
# SGLANG_MODEL=Qwen/Qwen2-0.5B-Instruct
# SGLANG_PORT=8000
# REPO_GIT_URL=https://github.com/org/repo.git  # build-arg for clone
# REPO_GIT_BRANCH=main
